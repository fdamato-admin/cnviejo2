+import React, { useState } from 'react';
+import PresupuestoDashboard from './PresupuestoDashboard';
+import PartidasAdmin from './PartidasAdmin';
+import CuotasAdmin from './CuotasAdmin';
+
+const TABS = [
+  { key: 'dashboard', label: '📊 Presupuesto Mensual' },
+  { key: 'partidas', label: '📋 Partidas' },
+  { key: 'cuotas', label: '📆 Cuotas a Plazo' },
+];
+
+export default function Presupuesto() {
+  const [tab, setTab] = useState('dashboard');
+
+  return (
+    <div style={{ padding: '24px', maxWidth: 1100, margin: '0 auto' }}>
+      <h2 style={{ marginBottom: 20, color: '#1a237e' }}>💰 Presupuesto Mensual</h2>
+
+      {/* Tabs */}
+      <div style={{ display: 'flex', gap: 8, marginBottom: 24, borderBottom: '2px solid #e0e0e0', paddingBottom: 0 }}>
+        {TABS.map(t => (
+          <button
+            key={t.key}
+            onClick={() => setTab(t.key)}
+            style={{
+              padding: '10px 20px',
+              border: 'none',
+              background: 'none',
+              cursor: 'pointer',
+              fontWeight: tab === t.key ? 700 : 400,
+              color: tab === t.key ? '#1a237e' : '#555',
+              borderBottom: tab === t.key ? '3px solid #1a237e' : '3px solid transparent',
+              marginBottom: -2,
+              fontSize: 14,
+            }}
+          >
+            {t.label}
+          </button>
+        ))}
+      </div>
+
+      {tab === 'dashboard' && <PresupuestoDashboard />}
+      {tab === 'partidas' && <PartidasAdmin />}
+      {tab === 'cuotas' && <CuotasAdmin />}
+    </div>
+  );
+}
