 =?UTF-8?q?=20eliminar=20cotizaci=C3=B3n?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Si se eliminan todas las cotizaciones, el trabajo vuelve a
pendiente_cotizacion. Si quedan cotizaciones, se mantiene
cotizaciones_recibidas. Estados avanzados (aprobado, en_ejecucion,
completado, cancelado) no se tocan.

Co-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_019gnkJ7zAKXqzLMjeCW8Bef
---
 backend/app/api/trabajos.py | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/backend/app/api/trabajos.py b/backend/app/api/trabajos.py
index 28e5d04..a1ef125 100644
--- a/backend/app/api/trabajos.py
+++ b/backend/app/api/trabajos.py
@@ -103,5 +103,15 @@ def eliminar_cotizacion(cotizacion_id: int, db: Session = Depends(get_db)):
     cotizacion = db.query(Cotizacion).filter(Cotizacion.id == cotizacion_id).first()
     if not cotizacion:
         raise HTTPException(status_code=404, detail="Cotización no encontrada")
+    trabajo_id = cotizacion.trabajo_id
     db.delete(cotizacion)
+    db.flush()
+    # Recalcular estado del trabajo según cotizaciones restantes
+    trabajo = db.query(Trabajo).filter(Trabajo.id == trabajo_id).first()
+    if trabajo and trabajo.estado not in (EstadoTrabajo.aprobado, EstadoTrabajo.en_ejecucion, EstadoTrabajo.completado, EstadoTrabajo.cancelado):
+        restantes = db.query(Cotizacion).filter(Cotizacion.trabajo_id == trabajo_id).count()
+        if restantes == 0:
+            trabajo.estado = EstadoTrabajo.pendiente_cotizacion
+        else:
+            trabajo.estado = EstadoTrabajo.cotizaciones_recibidas
     db.commit()
