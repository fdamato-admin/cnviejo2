+"""
+API de Presupuesto Mensual
+Partidas fijas, variables, imprevistos y cuotas a plazo.
+"""
+from fastapi import APIRouter, Depends, HTTPException
+from sqlalchemy.orm import Session
+from sqlalchemy import func
+from typing import List, Optional
+from decimal import Decimal
+
+from ..database import get_db
+from ..models import Partida, PresupuestoMensual, LineaPresupuesto, GastoMensual, CuotaPlazo, TipoPartida
+from ..schemas import (
+    PartidaCreate, PartidaUpdate, PartidaOut,
+    PresupuestoMensualCreate, PresupuestoMensualUpdate, PresupuestoMensualOut,
+    LineaPresupuestoCreate, LineaPresupuestoUpdate, LineaPresupuestoOut,
+    GastoMensualCreate, GastoMensualOut,
+    CuotaPlazoCreate, CuotaPlazoUpdate, CuotaPlazoOut,
+)
+
+router = APIRouter(prefix="/presupuesto", tags=["presupuesto"])
+
+MESES_PROMEDIO = 6  # cuántos meses hacia atrás para calcular promedio de variables
+
+
+# ─────────────────────────────────────────────────────────────────
+# PARTIDAS (catálogo)
+# ─────────────────────────────────────────────────────────────────
+
+@router.get("/partidas", response_model=List[PartidaOut])
+def listar_partidas(activa: Optional[bool] = None, db: Session = Depends(get_db)):
+    q = db.query(Partida)
+    if activa is not None:
+        q = q.filter(Partida.activa == activa)
+    return q.order_by(Partida.orden, Partida.id).all()
+
+
+@router.post("/partidas", response_model=PartidaOut, status_code=201)
+def crear_partida(data: PartidaCreate, db: Session = Depends(get_db)):
+    partida = Partida(**data.model_dump())
+    db.add(partida)
+    db.commit()
+    db.refresh(partida)
+    return partida
+
+
+@router.put("/partidas/{partida_id}", response_model=PartidaOut)
+def actualizar_partida(partida_id: int, data: PartidaUpdate, db: Session = Depends(get_db)):
+    partida = db.query(Partida).filter(Partida.id == partida_id).first()
+    if not partida:
+        raise HTTPException(status_code=404, detail="Partida no encontrada")
+    for k, v in data.model_dump(exclude_unset=True).items():
+        setattr(partida, k, v)
+    db.commit()
+    db.refresh(partida)
+    return partida
+
+
+@router.delete("/partidas/{partida_id}", status_code=204)
+def eliminar_partida(partida_id: int, db: Session = Depends(get_db)):
+    partida = db.query(Partida).filter(Partida.id == partida_id).first()
+    if not partida:
+        raise HTTPException(status_code=404, detail="Partida no encontrada")
+    db.delete(partida)
+    db.commit()
+
+
+# ─────────────────────────────────────────────────────────────────
+# GASTOS MENSUALES HISTÓRICOS
+# ─────────────────────────────────────────────────────────────────
+
+@router.get("/gastos", response_model=List[GastoMensualOut])
+def listar_gastos(partida_id: Optional[int] = None, anio: Optional[int] = None, mes: Optional[int] = None, db: Session = Depends(get_db)):
+    q = db.query(GastoMensual)
+    if partida_id:
+        q = q.filter(GastoMensual.partida_id == partida_id)
+    if anio:
+        q = q.filter(GastoMensual.anio == anio)
+    if mes:
+        q = q.filter(GastoMensual.mes == mes)
+    return q.order_by(GastoMensual.anio.desc(), GastoMensual.mes.desc()).all()
+
+
+@router.post("/gastos", response_model=GastoMensualOut, status_code=201)
+def registrar_gasto(data: GastoMensualCreate, db: Session = Depends(get_db)):
+    # Verificar que no exista ya gasto para esa partida/mes/año
+    existe = db.query(GastoMensual).filter(
+        GastoMensual.partida_id == data.partida_id,
+        GastoMensual.anio == data.anio,
+        GastoMensual.mes == data.mes,
+    ).first()
+    if existe:
+        # Actualizar en lugar de duplicar
+        existe.monto = data.monto
+        existe.notas = data.notas
+        db.commit()
+        db.refresh(existe)
+        return existe
+    gasto = GastoMensual(**data.model_dump())
+    db.add(gasto)
+    db.commit()
+    db.refresh(gasto)
+    return gasto
+
+
+@router.delete("/gastos/{gasto_id}", status_code=204)
+def eliminar_gasto(gasto_id: int, db: Session = Depends(get_db)):
+    gasto = db.query(GastoMensual).filter(GastoMensual.id == gasto_id).first()
+    if not gasto:
+        raise HTTPException(status_code=404, detail="Gasto no encontrado")
+    db.delete(gasto)
+    db.commit()
+
+
+# ─────────────────────────────────────────────────────────────────
+# CUOTAS A PLAZO
+# ─────────────────────────────────────────────────────────────────
+
+@router.get("/cuotas", response_model=List[CuotaPlazoOut])
+def listar_cuotas(activa: Optional[bool] = None, db: Session = Depends(get_db)):
+    q = db.query(CuotaPlazo)
+    if activa is not None:
+        q = q.filter(CuotaPlazo.activa == activa)
+    return q.order_by(CuotaPlazo.anio_inicio.desc(), CuotaPlazo.mes_inicio.desc()).all()
+
+
+@router.post("/cuotas", response_model=CuotaPlazoOut, status_code=201)
+def crear_cuota(data: CuotaPlazoCreate, db: Session = Depends(get_db)):
+    cuota = CuotaPlazo(**data.model_dump())
+    db.add(cuota)
+    db.commit()
+    db.refresh(cuota)
+    return cuota
+
+
+@router.put("/cuotas/{cuota_id}", response_model=CuotaPlazoOut)
+def actualizar_cuota(cuota_id: int, data: CuotaPlazoUpdate, db: Session = Depends(get_db)):
+    cuota = db.query(CuotaPlazo).filter(CuotaPlazo.id == cuota_id).first()
+    if not cuota:
+        raise HTTPException(status_code=404, detail="Cuota no encontrada")
+    for k, v in data.model_dump(exclude_unset=True).items():
+        setattr(cuota, k, v)
+    # Si ya se pagaron todas, desactivar
+    if cuota.cuotas_pagadas >= cuota.num_cuotas:
+        cuota.activa = False
+    db.commit()
+    db.refresh(cuota)
+    return cuota
+
+
+@router.delete("/cuotas/{cuota_id}", status_code=204)
+def eliminar_cuota(cuota_id: int, db: Session = Depends(get_db)):
+    cuota = db.query(CuotaPlazo).filter(CuotaPlazo.id == cuota_id).first()
+    if not cuota:
+        raise HTTPException(status_code=404, detail="Cuota no encontrada")
+    db.delete(cuota)
+    db.commit()
+
+
+# ─────────────────────────────────────────────────────────────────
+# PRESUPUESTOS MENSUALES
+# ─────────────────────────────────────────────────────────────────
+
+@router.get("/", response_model=List[PresupuestoMensualOut])
+def listar_presupuestos(db: Session = Depends(get_db)):
+    return db.query(PresupuestoMensual).order_by(
+        PresupuestoMensual.anio.desc(), PresupuestoMensual.mes.desc()
+    ).all()
+
+
+@router.get("/{anio}/{mes}", response_model=PresupuestoMensualOut)
+def obtener_presupuesto(anio: int, mes: int, db: Session = Depends(get_db)):
+    p = db.query(PresupuestoMensual).filter(
+        PresupuestoMensual.anio == anio,
+        PresupuestoMensual.mes == mes,
+    ).first()
+    if not p:
+        raise HTTPException(status_code=404, detail="Presupuesto no encontrado")
+    return p
+
+
+@router.post("/generar/{anio}/{mes}", response_model=PresupuestoMensualOut, status_code=201)
+def generar_presupuesto(anio: int, mes: int, meta_por_villa: Optional[Decimal] = None, db: Session = Depends(get_db)):
+    """
+    Genera automáticamente el presupuesto del mes basado en:
+    - Partidas fijas: usa monto_referencia
+    - Partidas variables: calcula promedio de los últimos N meses
+    - Cuotas a plazo activas: incluye cuotas vigentes para ese mes
+    """
+    # Verificar si ya existe
+    existe = db.query(PresupuestoMensual).filter(
+        PresupuestoMensual.anio == anio,
+        PresupuestoMensual.mes == mes,
+    ).first()
+    if existe:
+        raise HTTPException(status_code=409, detail="Ya existe un presupuesto para este mes")
+
+    partidas = db.query(Partida).filter(Partida.activa == True).order_by(Partida.orden).all()
+
+    lineas = []
+    total = Decimal("0")
+
+    for orden_idx, partida in enumerate(partidas):
+        monto_ppto = None
+
+        if partida.tipo == TipoPartida.fija:
+            monto_ppto = partida.monto_referencia or Decimal("0")
+
+        elif partida.tipo == TipoPartida.variable:
+            # Calcular promedio de los últimos MESES_PROMEDIO meses con datos
+            gastos_recientes = db.query(GastoMensual).filter(
+                GastoMensual.partida_id == partida.id,
+            ).order_by(GastoMensual.anio.desc(), GastoMensual.mes.desc()).limit(MESES_PROMEDIO).all()
+
+            if gastos_recientes:
+                monto_ppto = sum(g.monto for g in gastos_recientes) / len(gastos_recientes)
+            else:
+                monto_ppto = partida.monto_referencia or Decimal("0")
+
+        elif partida.tipo in (TipoPartida.imprevisto, TipoPartida.cuota):
+            monto_ppto = partida.monto_referencia or Decimal("0")
+
+        linea = LineaPresupuesto(
+            nombre_partida=partida.nombre,
+            tipo=partida.tipo,
+            partida_id=partida.id,
+            monto_presupuestado=monto_ppto,
+            orden=orden_idx,
+        )
+        lineas.append(linea)
+        if monto_ppto:
+            total += monto_ppto
+
+    # Agregar cuotas a plazo activas para este mes
+    cuotas_activas = db.query(CuotaPlazo).filter(CuotaPlazo.activa == True).all()
+    for cuota in cuotas_activas:
+        # Verificar si la cuota aplica para este mes
+        inicio_abs = cuota.anio_inicio * 12 + cuota.mes_inicio
+        actual_abs = anio * 12 + mes
+        fin_abs = inicio_abs + cuota.num_cuotas - 1
+        if inicio_abs <= actual_abs <= fin_abs and cuota.cuotas_pagadas < cuota.num_cuotas:
+            linea = LineaPresupuesto(
+                nombre_partida=f"Cuota: {cuota.descripcion}",
+                tipo=TipoPartida.cuota,
+                partida_id=cuota.partida_id,
+                monto_presupuestado=cuota.monto_cuota,
+                orden=9000 + cuota.id,
+                notas=f"Cuota {cuota.cuotas_pagadas + 1}/{cuota.num_cuotas}",
+            )
+            lineas.append(linea)
+            total += cuota.monto_cuota
+
+    presupuesto = PresupuestoMensual(
+        anio=anio,
+        mes=mes,
+        meta_por_villa=meta_por_villa,
+        total_presupuestado=total,
+        lineas=lineas,
+    )
+    db.add(presupuesto)
+    db.commit()
+    db.refresh(presupuesto)
+    return presupuesto
+
+
+@router.put("/{presupuesto_id}", response_model=PresupuestoMensualOut)
+def actualizar_presupuesto(presupuesto_id: int, data: PresupuestoMensualUpdate, db: Session = Depends(get_db)):
+    p = db.query(PresupuestoMensual).filter(PresupuestoMensual.id == presupuesto_id).first()
+    if not p:
+        raise HTTPException(status_code=404, detail="Presupuesto no encontrado")
+    for k, v in data.model_dump(exclude_unset=True).items():
+        setattr(p, k, v)
+    db.commit()
+    db.refresh(p)
+    return p
+
+
+@router.put("/{presupuesto_id}/lineas/{linea_id}", response_model=LineaPresupuestoOut)
+def actualizar_linea(presupuesto_id: int, linea_id: int, data: LineaPresupuestoUpdate, db: Session = Depends(get_db)):
+    linea = db.query(LineaPresupuesto).filter(
+        LineaPresupuesto.id == linea_id,
+        LineaPresupuesto.presupuesto_id == presupuesto_id,
+    ).first()
+    if not linea:
+        raise HTTPException(status_code=404, detail="Línea no encontrada")
+    for k, v in data.model_dump(exclude_unset=True).items():
+        setattr(linea, k, v)
+
+    # Recalcular totales del presupuesto
+    presupuesto = db.query(PresupuestoMensual).filter(PresupuestoMensual.id == presupuesto_id).first()
+    if presupuesto:
+        lineas = db.query(LineaPresupuesto).filter(LineaPresupuesto.presupuesto_id == presupuesto_id).all()
+        presupuesto.total_presupuestado = sum(l.monto_presupuestado or 0 for l in lineas)
+        presupuesto.total_real = sum(l.monto_real or 0 for l in lineas if l.monto_real is not None)
+
+    db.commit()
+    db.refresh(linea)
+    return linea
+
+
+@router.post("/{presupuesto_id}/lineas", response_model=LineaPresupuestoOut, status_code=201)
+def agregar_linea(presupuesto_id: int, data: LineaPresupuestoCreate, db: Session = Depends(get_db)):
+    p = db.query(PresupuestoMensual).filter(PresupuestoMensual.id == presupuesto_id).first()
+    if not p:
+        raise HTTPException(status_code=404, detail="Presupuesto no encontrado")
+    linea = LineaPresupuesto(presupuesto_id=presupuesto_id, **data.model_dump())
+    db.add(linea)
+    db.commit()
+    db.refresh(linea)
+    return linea
+
+
+@router.delete("/{presupuesto_id}/lineas/{linea_id}", status_code=204)
+def eliminar_linea(presupuesto_id: int, linea_id: int, db: Session = Depends(get_db)):
+    linea = db.query(LineaPresupuesto).filter(
+        LineaPresupuesto.id == linea_id,
+        LineaPresupuesto.presupuesto_id == presupuesto_id,
+    ).first()
+    if not linea:
+        raise HTTPException(status_code=404, detail="Línea no encontrada")
+    db.delete(linea)
+    db.commit()
+
+
+@router.delete("/{presupuesto_id}", status_code=204)
+def eliminar_presupuesto(presupuesto_id: int, db: Session = Depends(get_db)):
+    p = db.query(PresupuestoMensual).filter(PresupuestoMensual.id == presupuesto_id).first()
+    if not p:
+        raise HTTPException(status_code=404, detail="Presupuesto no encontrado")
+    db.delete(p)
+    db.commit()
+
+
+# ─────────────────────────────────────────────────────────────────
+# RESUMEN / DASHBOARD
+# ─────────────────────────────────────────────────────────────────
+
+@router.get("/{anio}/{mes}/resumen")
+def resumen_presupuesto(anio: int, mes: int, db: Session = Depends(get_db)):
+    """Devuelve el presupuesto del mes con comparativo presupuestado vs real."""
+    p = db.query(PresupuestoMensual).filter(
+        PresupuestoMensual.anio == anio,
+        PresupuestoMensual.mes == mes,
+    ).first()
+    if not p:
+        raise HTTPException(status_code=404, detail="Presupuesto no encontrado")
+
+    lineas_out = []
+    for l in sorted(p.lineas, key=lambda x: x.orden):
+        ppto = float(l.monto_presupuestado or 0)
+        real = float(l.monto_real or 0)
+        diff = real - ppto
+        lineas_out.append({
+            "id": l.id,
+            "nombre": l.nombre_partida,
+            "tipo": l.tipo,
+            "presupuestado": ppto,
+            "real": real,
+            "diferencia": diff,
+            "pct_ejecucion": round(real / ppto * 100, 1) if ppto else None,
+            "notas": l.notas,
+        })
+
+    total_ppto = float(p.total_presupuestado or 0)
+    total_real = float(p.total_real or 0)
+    num_villas = 79  # total villas del conjunto a alicuota 1.26%
+
+    return {
+        "anio": anio,
+        "mes": mes,
+        "meta_por_villa": float(p.meta_por_villa or 0),
+        "total_presupuestado": total_ppto,
+        "total_real": total_real,
+        "diferencia": total_real - total_ppto,
+        "por_villa_presupuestado": round(total_ppto / num_villas, 2),
+        "por_villa_real": round(total_real / num_villas, 2),
+        "cerrado": p.cerrado,
+        "lineas": lineas_out,
+    }
