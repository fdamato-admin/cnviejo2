+from fastapi import APIRouter, Depends, HTTPException
+from sqlalchemy.orm import Session
+from typing import List
+from ..database import get_db
+from ..models import Usuario, Permiso, NivelPermiso
+from ..schemas import UsuarioCreate, UsuarioUpdate, UsuarioOut, LoginIn, TokenOut
+from ..auth import hash_password, verify_password, create_token, get_current_user, require_permiso
+
+router = APIRouter(prefix="/auth", tags=["auth"])
+
+
+@router.post("/login", response_model=TokenOut)
+def login(data: LoginIn, db: Session = Depends(get_db)):
+    user = db.query(Usuario).filter(Usuario.email == data.email.lower(), Usuario.activo == True).first()
+    if not user or not verify_password(data.password, user.password_hash):
+        raise HTTPException(status_code=401, detail="Credenciales incorrectas")
+    token = create_token({"sub": str(user.id)})
+    return {"access_token": token, "token_type": "bearer", "usuario": user}
+
+
+@router.get("/me", response_model=UsuarioOut)
+def me(usuario: Usuario = Depends(get_current_user)):
+    return usuario
+
+
+# ── Gestión de usuarios (solo admin global) ──────────────────────────────────
+
+@router.get("/usuarios", response_model=List[UsuarioOut])
+def listar_usuarios(
+    db: Session = Depends(get_db),
+    _: Usuario = Depends(require_permiso("*", NivelPermiso.admin))
+):
+    return db.query(Usuario).order_by(Usuario.nombre).all()
+
+
+@router.post("/usuarios", response_model=UsuarioOut, status_code=201)
+def crear_usuario(
+    data: UsuarioCreate,
+    db: Session = Depends(get_db),
+    _: Usuario = Depends(require_permiso("*", NivelPermiso.admin))
+):
+    if db.query(Usuario).filter(Usuario.email == data.email.lower()).first():
+        raise HTTPException(status_code=400, detail="Email ya registrado")
+    user = Usuario(
+        nombre=data.nombre.upper(),
+        email=data.email.lower(),
+        password_hash=hash_password(data.password)
+    )
+    db.add(user)
+    db.flush()
+    for p in data.permisos:
+        db.add(Permiso(usuario_id=user.id, modulo=p.modulo, nivel=p.nivel))
+    db.commit()
+    db.refresh(user)
+    return user
+
+
+@router.put("/usuarios/{uid}", response_model=UsuarioOut)
+def editar_usuario(
+    uid: int,
+    data: UsuarioUpdate,
+    db: Session = Depends(get_db),
+    _: Usuario = Depends(require_permiso("*", NivelPermiso.admin))
+):
+    user = db.query(Usuario).filter(Usuario.id == uid).first()
+    if not user:
+        raise HTTPException(status_code=404, detail="Usuario no encontrado")
+    if data.nombre is not None:
+        user.nombre = data.nombre.upper()
+    if data.email is not None:
+        user.email = data.email.lower()
+    if data.password is not None:
+        user.password_hash = hash_password(data.password)
+    if data.activo is not None:
+        user.activo = data.activo
+    if data.permisos is not None:
+        db.query(Permiso).filter(Permiso.usuario_id == uid).delete()
+        for p in data.permisos:
+            db.add(Permiso(usuario_id=uid, modulo=p.modulo, nivel=p.nivel))
+    db.commit()
+    db.refresh(user)
+    return user
+
+
+@router.delete("/usuarios/{uid}", status_code=204)
+def eliminar_usuario(
+    uid: int,
+    db: Session = Depends(get_db),
+    current: Usuario = Depends(require_permiso("*", NivelPermiso.admin))
+):
+    if uid == current.id:
+        raise HTTPException(status_code=400, detail="No puedes eliminar tu propio usuario")
+    user = db.query(Usuario).filter(Usuario.id == uid).first()
+    if not user:
+        raise HTTPException(status_code=404, detail="No encontrado")
+    db.delete(user)
+    db.commit()
+
+
+@router.post("/seed", status_code=201)
+def seed_admin(db: Session = Depends(get_db)):
+    """Crea el primer usuario admin. Solo funciona si no hay usuarios."""
+    if db.query(Usuario).count() > 0:
+        raise HTTPException(status_code=400, detail="Ya existen usuarios")
+    user = Usuario(
+        nombre="ADMINISTRADOR",
+        email="admin@cnpuebloviejo2.com",
+        password_hash=hash_password("admin2024")
+    )
+    db.add(user)
+    db.flush()
+    db.add(Permiso(usuario_id=user.id, modulo="*", nivel=NivelPermiso.admin))
+    db.commit()
+    return {"msg": "Admin creado", "email": "admin@cnpuebloviejo2.com", "password": "admin2024"}
